{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "NeatStream Design Tokens (DTCG Specification)",
  "version": "2.0.0",
  "description": "Design Tokens oficiais do NeatStream 2026 com paridade semântica entre temas Dark e Light, conformidade estrita WCAG AA/AAA e matriz de estados interativos.",
  "color": {
    "dark": {
      "bg": {
        "base": { "$value": "#080C0A", "$type": "color", "$description": "Fundo principal obsidian (cinema apagado)" },
        "surface": { "$value": "#111714", "$type": "color", "$description": "Cards e superfícies elevadas" },
        "raised": { "$value": "#161F1B", "$type": "color", "$description": "Containers de destaque, painéis flutuantes" }
      },
      "border": {
        "subtle": { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color", "$description": "Divisórias estruturais e micro-bordas" },
        "strong": { "$value": "rgba(255, 255, 255, 0.16)", "$type": "color", "$description": "Bordas de foco e divisórias ativas" }
      },
      "text": {
        "primary": { "$value": "#E8EDF2", "$type": "color", "$description": "Títulos e valores principais (contraste 13.8:1)" },
        "secondary": { "$value": "#9BA6B2", "$type": "color", "$description": "Metadados, legendas e rótulos de apoio (contraste 6.2:1)" }
      },
      "accent": {
        "mint": { "$value": "#00E599", "$type": "color", "$description": "Cor primária da marca, CTAs, Econômetro positivo" },
        "mintLight": { "$value": "#34F5B2", "$type": "color", "$description": "Gradientes luminosos e microinterações" },
        "lavender": { "$value": "#8B9BFF", "$type": "color", "$description": "Comunidade, reviews, notas neutras" },
        "gold": { "$value": "#F5B84C", "$type": "color", "$description": "Gamificação, conquistas, selos de usuário" }
      },
      "semantic": {
        "warning": { "$value": "#FF9838", "$type": "color", "$description": "Alerta de ociosidade (laranja quente desambiguado de gold)" },
        "danger": { "$value": "#FF5C5C", "$type": "color", "$description": "Estouro orçamentário e cancelamento definitivo" }
      }
    },
    "light": {
      "bg": {
        "base": { "$value": "#FAFBFC", "$type": "color", "$description": "Fundo claro neutro antirreflexo" },
        "surface": { "$value": "#FFFFFF", "$type": "color", "$description": "Cards brancos puros" },
        "raised": { "$value": "#FFFFFF", "$type": "color", "$description": "Superfície elevada com sombra suave (0 4px 14px rgba(0,0,0,0.06))" }
      },
      "border": {
        "subtle": { "$value": "#E2E8F0", "$type": "color", "$description": "Bordas estruturais de baixo contraste" },
        "strong": { "$value": "#CBD5E1", "$type": "color", "$description": "Bordas ativas e divisórias destacadas" }
      },
      "text": {
        "primary": { "$value": "#0E1116", "$type": "color", "$description": "Texto primário de alto contraste (17.2:1 - WCAG AAA)" },
        "secondary": { "$value": "#64748B", "$type": "color", "$description": "Slate secundário para metadados (4.6:1 - WCAG AA)" }
      },
      "accent": {
        "mintText": { "$value": "#0E7C5B", "$type": "color", "$description": "Menta escurecido para textos com contraste 5.0:1 (WCAG AA)" },
        "mintGraphic": { "$value": "#16A37A", "$type": "color", "$description": "Menta para elementos gráficos e badges grandes" },
        "lavenderText": { "$value": "#4F46E5", "$type": "color", "$description": "Lavanda para texto com contraste 5.5:1 (WCAG AA)" },
        "lavenderGraphic": { "$value": "#6366F1", "$type": "color", "$description": "Lavanda gráfico para ícones e badges" },
        "goldText": { "$value": "#A16207", "$type": "color", "$description": "Texto de selos com contraste 5.1:1 (WCAG AA)" },
        "goldGraphic": { "$value": "#D97706", "$type": "color", "$description": "Ouro para ícones e troféus gráficos" }
      },
      "semantic": {
        "warning": { "$value": "#B45309", "$type": "color", "$description": "Alerta de ociosidade com contraste 4.8:1 sobre branco" },
        "danger": { "$value": "#DC2626", "$type": "color", "$description": "Erro e cancelamento com contraste 4.9:1 sobre branco" }
      }
    }
  },
  "state": {
    "hover": {
      "mintDark": { "$value": "#4BDDAE", "$type": "color", "$description": "Mint clareado em 8% para hover no tema escuro" },
      "mintLight": { "$value": "#0A6046", "$type": "color", "$description": "Mint escurecido em 8% para hover no tema claro" }
    },
    "pressed": {
      "brightnessRatio": { "$value": "0.88", "$type": "number", "$description": "Escurecimento de 12% no clique/toque ativo" }
    },
    "focusRing": {
      "style": { "$value": "2px solid #00E599", "$type": "string" },
      "offset": { "$value": "2px", "$type": "dimension" },
      "selector": { "$value": ":focus-visible", "$type": "string", "$description": "Visível exclusivamente em navegação por teclado" }
    },
    "disabled": {
      "opacity": { "$value": "0.40", "$type": "number" },
      "cursor": { "$value": "not-allowed", "$type": "string" }
    },
    "overlay": {
      "scrim": { "$value": "rgba(8, 12, 10, 0.70)", "$type": "color", "$description": "Escurecimento de 70% com backdrop-blur para modais" }
    },
    "loading": {
      "type": { "$value": "skeleton", "$type": "string", "$description": "Animação shimmer com gradiente sutil de carregamento" }
    }
  },
  "dataVizRamp": {
    "step1": { "$value": "#00E599", "$type": "color", "$description": "1º lugar / Streaming mais assistido / Mint" },
    "step2": { "$value": "#8B9BFF", "$type": "color", "$description": "2º lugar / Bom uso / Lavender" },
    "step3": { "$value": "#F5B84C", "$type": "color", "$description": "3º lugar / Uso intermediário / Gold" },
    "step4": { "$value": "#6BB8FF", "$type": "color", "$description": "4º lugar / Uso baixo / Sky Blue" },
    "step5": { "$value": "#FF5C5C", "$type": "color", "$description": "5º lugar / Sem uso / Coral" }
  },
  "typography": {
    "fontFamily": {
      "display": { "$value": "Sora, -apple-system, sans-serif", "$type": "fontFamily", "$description": "Títulos e identidade de precisão tech" },
      "body": { "$value": "Inter, -apple-system, sans-serif", "$type": "fontFamily", "$description": "Corpo e UI densa de máxima legibilidade" },
      "value": { "$value": "IBM Plex Mono, monospace", "$type": "fontFamily", "$description": "Moeda, horas, datas e números tabulares (tnum)" }
    },
    "scale": {
      "displayLg": {
        "fontSize": { "$value": "56px", "$type": "dimension" },
        "lineHeight": { "$value": "64px", "$type": "dimension" },
        "fontFamily": { "$value": "{typography.fontFamily.display}" },
        "fontWeight": { "$value": "700" },
        "usage": "Hero principal da Landing Page"
      },
      "display": {
        "fontSize": { "$value": "40px", "$type": "dimension" },
        "lineHeight": { "$value": "48px", "$type": "dimension" },
        "fontFamily": { "$value": "{typography.fontFamily.display}" },
        "fontWeight": { "$value": "700" },
        "usage": "Títulos de seção da Landing e Dashboard"
      },
      "title": {
        "fontSize": { "$value": "28px", "$type": "dimension" },
        "lineHeight": { "$value": "36px", "$type": "dimension" },
        "fontFamily": { "$value": "{typography.fontFamily.display}" },
        "fontWeight": { "$value": "600" },
        "usage": "Header principal de telas mobile"
      },
      "heading": {
        "fontSize": { "$value": "20px", "$type": "dimension" },
        "lineHeight": { "$value": "28px", "$type": "dimension" },
        "fontFamily": { "$value": "{typography.fontFamily.display}" },
        "fontWeight": { "$value": "600" },
        "usage": "Títulos de cards e destaques"
      },
      "bodyLg": {
        "fontSize": { "$value": "16px", "$type": "dimension" },
        "lineHeight": { "$value": "24px", "$type": "dimension" },
        "fontFamily": { "$value": "{typography.fontFamily.body}" },
        "fontWeight": { "$value": "400" },
        "usage": "Padrão de leitura mobile e parágrafos principais"
      },
      "body": {
        "fontSize": { "$value": "14px", "$type": "dimension" },
        "lineHeight": { "$value": "20px", "$type": "dimension" },
        "fontFamily": { "$value": "{typography.fontFamily.body}" },
        "fontWeight": { "$value": "400" },
        "usage": "UI densa, tabelas e descrições curtas"
      },
      "caption": {
        "fontSize": { "$value": "12px", "$type": "dimension" },
        "lineHeight": { "$value": "16px", "$type": "dimension" },
        "fontFamily": { "$value": "{typography.fontFamily.body}" },
        "fontWeight": { "$value": "500" },
        "usage": "Metadados, notas secundárias e legendas"
      },
      "labelCaps": {
        "fontSize": { "$value": "12px", "$type": "dimension" },
        "lineHeight": { "$value": "16px", "$type": "dimension" },
        "fontFamily": { "$value": "{typography.fontFamily.body}" },
        "fontWeight": { "$value": "600" },
        "letterSpacing": { "$value": "0.08em", "$type": "dimension" },
        "textTransform": { "$value": "uppercase", "$type": "string" },
        "usage": "Badges de status, ECONÔMETRO, PRÓXIMA FATURA (sempre com contexto de apoio)"
      },
      "value": {
        "fontSize": { "$value": "14px", "$type": "dimension" },
        "lineHeight": { "$value": "20px", "$type": "dimension" },
        "fontFamily": { "$value": "{typography.fontFamily.value}" },
        "fontWeight": { "$value": "500" },
        "fontFeatureSettings": { "$value": "'tnum' on, 'zero' on", "$type": "string" },
        "usage": "Moedas em R$, horas consumidas, datas e contadores"
      }
    }
  },
  "spacing": {
    "unit": { "$value": "8px", "$type": "dimension" },
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "2xl": { "$value": "40px", "$type": "dimension" },
    "3xl": { "$value": "48px", "$type": "dimension" }
  },
  "borderRadius": {
    "none": { "$value": "0px", "$type": "dimension" },
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension", "$description": "Botões secundários, inputs" },
    "md": { "$value": "12px", "$type": "dimension", "$description": "Cards compactos, containers internos" },
    "lg": { "$value": "16px", "$type": "dimension", "$description": "Cards principais de assinaturas" },
    "xl": { "$value": "24px", "$type": "dimension", "$description": "Cards herói e modais" },
    "full": { "$value": "9999px", "$type": "dimension", "$description": "Badges, pílulas de filtro e Floating Dock" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration", "$description": "Hover, press e microinterações" },
      "base": { "$value": "250ms", "$type": "duration", "$description": "Transições de telas, expansões de accordion" },
      "slow": { "$value": "400ms", "$type": "duration", "$description": "Contador de celebração e animação de gauge" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "string", "$description": "Curva desacelerada natural" }
    },
    "reducedMotion": {
      "$value": "@media (prefers-reduced-motion: reduce) { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }",
      "$type": "string",
      "$description": "Suporte obrigatório a acessibilidade vestibular"
    }
  },
  "layout": {
    "zIndex": {
      "base": { "$value": 0, "$type": "number" },
      "sticky": { "$value": 10, "$type": "number" },
      "dropdown": { "$value": 20, "$type": "number" },
      "modal": { "$value": 30, "$type": "number" },
      "toast": { "$value": 40, "$type": "number" },
      "tooltip": { "$value": 50, "$type": "number" }
    },
    "breakpoints": {
      "sm": { "$value": "360px", "$type": "dimension" },
      "md": { "$value": "768px", "$type": "dimension" },
      "lg": { "$value": "1024px", "$type": "dimension" },
      "xl": { "$value": "1280px", "$type": "dimension" },
      "containerMax": { "$value": "1200px", "$type": "dimension" }
    },
    "touchTarget": {
      "minIos": { "$value": "44px", "$type": "dimension" },
      "minAndroid": { "$value": "48px", "$type": "dimension" },
      "iconSize": { "$value": "24px", "$type": "dimension" }
    }
  },
  "iconography": {
    "stroke": { "$value": "1.5px", "$type": "dimension" },
    "sizes": {
      "sm": { "$value": "16px", "$type": "dimension" },
      "md": { "$value": "20px", "$type": "dimension" },
      "lg": { "$value": "24px", "$type": "dimension" }
    },
    "grid": { "$value": "2px", "$type": "dimension" },
    "thirdPartyLogosRule": "Nunca recolorir logotipos de serviços terceiros (Netflix, Max, Disney+, Apple TV+). Sempre exibi-los em sua forma original dentro de containers neutros com fundo bg.surface e borda border.subtle."
  }
}
